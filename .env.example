# Gemini AI - Get your key from https://aistudio.google.com/
GEMINI_API_KEY=""

# Application
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV=development

# Supabase — BizMate AI project (Mumbai, ap-south-1)
SUPABASE_URL="https://vvfwjtviygmsjbjxtvny.supabase.co"
# Public/publishable key; only expose to browsers after RLS policies are verified.
SUPABASE_PUBLISHABLE_KEY=""
# Server-only secret. Never prefix with VITE_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=""

# Razorpay — keep live secrets only in deployment secret manager / local .env
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Transactional email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="BizMate AI <hello@your-domain.com>"

# Poster image provider: huggingface (default), gemini, or muapi
POSTER_IMAGE_PROVIDER="huggingface"

# Hugging Face Inference Providers — server-only token with Inference Providers permission.
HF_TOKEN=""
HF_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"
HF_IMAGE_ENDPOINT="https://router.huggingface.co/fal-ai/fal-ai/flux/schnell"

# Optional Gemini image generation (image generation is not included in the standard free API tier).
GEMINI_IMAGE_MODEL="gemini-3.1-flash-lite-image"

# Cost telemetry — prices are USD
GEMINI_INPUT_USD_PER_MILLION_TOKENS=""
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=""
GEMINI_IMAGE_COST_USD=""
HF_IMAGE_COST_USD=""
MUAPI_POSTER_COST_USD=""
MUAPI_VIDEO_COST_USD=""

# Optional Open-Higgsfield-compatible video/legacy poster generation via MuAPI
MUAPI_API_KEY=""

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# YouTube OAuth
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/v1/auth/youtube/callback"

# Google Sheets
GOOGLE_SHEETS_CLIENT_EMAIL=""
GOOGLE_SHEETS_PRIVATE_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID=""
