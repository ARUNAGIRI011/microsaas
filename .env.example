# Gemini AI
GEMINI_API_KEY=""

# Application
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV=development

# Supabase — BizMate AI project (Mumbai, ap-south-1)
SUPABASE_URL="https://vvfwjtviygmsjbjxtvny.supabase.co"
# Public/publishable key; only expose to browsers after RLS policies are verified.
SUPABASE_PUBLISHABLE_KEY=""
# Server-only secret. Never prefix with VITE_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=""

# Razorpay — keep live secrets only in deployment secret manager
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Transactional email
RESEND_API_KEY=""
EMAIL_FROM="BizMate AI <hello@your-verified-domain.com>"

# Poster image provider: huggingface (default, limited monthly HF credit), gemini (paid image model), or muapi (may be billed).
POSTER_IMAGE_PROVIDER="huggingface"

# Hugging Face Inference Providers — server-only token with Inference Providers permission.
# Free accounts receive a small monthly credit; this is not unlimited free generation.
HF_TOKEN=""
HF_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"
HF_IMAGE_ENDPOINT="https://router.huggingface.co/fal-ai/fal-ai/flux/schnell"

# Optional Gemini image generation (image generation is not included in the standard free API tier).
# Set POSTER_IMAGE_PROVIDER="gemini" only if you accept the model's current API pricing.
GEMINI_IMAGE_MODEL="gemini-3.1-flash-lite-image"

# Optional Open-Higgsfield-compatible video/legacy poster generation via MuAPI; usage may be billed.
MUAPI_API_KEY=""

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# YouTube OAuth
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/v1/auth/youtube/callback"

# Google Sheets
GOOGLE_SHEETS_CLIENT_EMAIL=""
GOOGLE_SHEETS_PRIVATE_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID=""
